module imm_gen (
	input wire [31:0] instruction,
	output reg [31:0] immediate
);

	localparam OPCODE_ITYPE = 7'b0010011; // alu imm instruction: addi, slti, andi, etc.
   localparam OPCODE_LOAD = 7'b0000011;
   localparam OPCODE_JALR = 7'b1100111; // does an unconditional jump: it sets PC = PC + imm
   localparam OPCODE_STORE = 7'b0100011;
   localparam OPCODE_BRANCH = 7'b1100011;
   localparam OPCODE_LUI = 7'b0110111; // loads a 20-bit immediate into the upper 20 bits of the destination register
   localparam OPCODE_AUIPC = 7'b0010111; //Add Upper Immediate to PC
   localparam OPCODE_JAL = 7'b1101111;
	
	wire [6:0] opcode = instruction[6:0];
	
	always @(*) begin
		case(opcode)
			OPCODE_ITYPE, OPCODE_LOAD, OPCODE_JALR:
				immediate = {{20{instruction[31]}}, instruction[31:20]};
				
			OPCODE_STORE:
				immediate = {{20{instr[31]}}, instr[31:25], instr[11:7]};
				
			OPCODE_BRANCH:
				immediate = {{19{instr[31]}}, instr[31], instr[7], instr[30:25], instr[11:8], 1'b0};
				
			OPCODE_LUI, OPCODE_AUIPC:
				immediate = {instr[31:12], 12'b0};
				
			OPCODE_JAL:
				immediate = {{11{instr[31]}}, instr[31], instr[19:12], instr[20], instr[30:21], 1'b0};

			default:
				immediate = 32'b0; // R-type instructions don't use an immediate
		end
	end
endmodule
