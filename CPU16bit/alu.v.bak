module alu (
	input wire [16:0] a, 
	input wire [16:0] b, 
	input wire [2:0] op,
	output reg [31:0] result,
	output reg negative,
	output reg zero,
	output reg carry,
	output reg overflow

);
	// Opcodes
	localparam OP_ADDSUB = 3'b000; // ADD if alt=0, SUB if alt=1
	localparam OP_LSL = 3'b001; 
	localparam OP_SLT = 3'b010;
	localparam OP_SLTU = 3'b011;
	localparam OP_XOR = 3'b100;
	localparam OP_LSRASR = 3'b101; // LSR if alt=0, ASR if alt=1
	localparam OP_OR = 3'b110;
	localparam OP_AND = 3'b111;
	
	always @(*) begin
		// defaults, prevents inferred latches if a branch doesn't fully assign
		result   = 32'b0;
		negative = 1'b0;
		zero     = 1'b0;
		carry    = 1'b0;
		overflow = 1'b0;
	 
		case (op)
			OP_ADDSUB: begin
				if (!alt) begin
					//ADD
					{carry, result} = a + b;
					overflow = (a[31] == b[31]) && (result[31] != a[31]);
				end else begin
					//SUB
               {carry, result} = a - b;
					overflow = (a[31] != b[31]) && (result[31] != a[31]);
				end
			end
			
			OP_LSL: result = a << b[4:0];
			OP_SLT: result = ($signed(a) < $signed(b)) ? 32'd1 : 32'd0;
			OP_SLTU: result = (a < b) ? 32'd1 : 32'd0;
			OP_XOR: result = a ^ b;
			
			OP_LSRASR: begin
            if (!alt)
                result = a >> b[4:0]; // LSR
            else
                result = $signed(a) >>> b[4:0]; // ASR
			end
			
			OP_OR: result = a | b;
			OP_AND: result = a & b;
			
			default: result = 32'b0;
		endcase
		
		negative = result[31];
		zero = (result == 32'b0);
	end
	
endmodule
