`timescale 1ns/1ps

module mux2to1_tb;

    reg a, b, sel;
    wire y;
    integer errors = 0;

    // Instantiate the design under test (DUT)
    mux2to1 dut (
        .a(a),
        .b(b),
        .sel(sel),
        .y(y)
    );

    // Dump waveform for GTKWave
    initial begin
        $dumpfile("mux2to1.vcd");
        $dumpvars(0, mux2to1_tb);
    end

    // Task to check one case and report pass/fail
    task check(input a_in, input b_in, input sel_in, input expected);
        begin
            a = a_in; b = b_in; sel = sel_in;
            #10; // wait for signals to settle
            if (y !== expected) begin
                $display("FAIL: a=%b b=%b sel=%b -> y=%b (expected %b)", a, b, sel, y, expected);
                errors = errors + 1;
            end else begin
                $display("PASS: a=%b b=%b sel=%b -> y=%b", a, b, sel, y);
            end
        end
    endtask

    initial begin
        // Exhaustively test all 8 input combinations (small enough to brute force)
        check(0, 0, 0, 0);
        check(0, 1, 0, 0);
        check(1, 0, 0, 1);
        check(1, 1, 0, 1);
        check(0, 0, 1, 0);
        check(0, 1, 1, 1);
        check(1, 0, 1, 0);
        check(1, 1, 1, 1);

        if (errors == 0)
            $display("ALL TESTS PASSED");
        else
            $display("%0d TEST(S) FAILED", errors);

        $finish;
    end

endmodule
